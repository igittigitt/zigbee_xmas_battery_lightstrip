# Versioned Kconfig defaults. sdkconfig is generated from this file
# (delete sdkconfig or run `idf.py fullclean` after changes here).
# Sources: esp-zigbee-sdk 2.0.5, examples/sleepy_devices/light_sleep_end_device/sdkconfig.defaults
# and docs/en/faq.rst ("Zigbee Light Sleep Mode"). Details: docs/zigbee-framework.md

# Zigbee: End Device, native 802.15.4 radio
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZED=y
CONFIG_ZB_RADIO_NATIVE=y

# Flash size: the ESP32-H2FH4S on the ESP32-H2-Zero has 4 MB in-package flash
# (boot log "Detected size(4096k)"); default would be 2 MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Partition table (Zigbee data is stored in the "nvs" partition; two OTA slots, goal Z16)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA rollback (goal Z16): a new image boots as PENDING_VERIFY and must confirm itself with
# esp_ota_mark_app_valid_cancel_rollback() (done after the network join, zigbee_device.c),
# "otherwise the application will be rolled back upon reboot" (ESP-IDF v5.5 system/ota.html)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Automatic light sleep (Sleepy End Device, goal Z1)
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_POWER_DOWN_PERIPHERAL_IN_LIGHT_SLEEP=y
CONFIG_IEEE802154_SLEEP_ENABLE=y
CONFIG_ESP_SLEEP_POWER_DOWN_FLASH=y
# 1000 Hz tick lowers the minimum light sleep time (comment in the 1.x example)
CONFIG_FREERTOS_HZ=1000

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# Project: primary build switch DEBUG level (main/Kconfig.projbuild)
# 0 = production, 1 = general tests on USB (no light sleep),
# 2 = energy saving tests (real light sleep, UART console)
CONFIG_ZL_DEBUG_LEVEL_1=y
